generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  //urlは書かない
}
/// 鉄道路線（oud2ファイル内の [Rosen] に相当）
/*model Route {
  id              Int         @id
  name            String         // Rosenmei (例: "京阪神線")
  kudariDiaAlias  String?        // KudariDiaAlias
  noboriDiaAlias  String?        // NoboriDiaAlias
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // リレーション
  //stations   Station[]
  trains          Train[]
  @@map("route") //テーブル名の定義
}*/
model Station {
  id             Int                    @id
  //route_id       Int
  name           String
  layout         String
  main           String
  railnumber     RailNumber[]
  outerterminal  Json // フロント側の `OuterTerminal` 配列をそのまま JSON として保持
  trainStopTimes TrainStopTime[]

  //route       Route @relation(fields: [route_id], references: [id], onDelete: Cascade)
  @@map("stations") //テーブル名の定義
}

model RailNumber {
  id         Int     @id @default(autoincrement())
  station_id Int //所属する駅のID
  rail_id    Int // JSON内のid
  name       String
  ryakushou  String
  station    Station  @relation(fields: [station_id], references: [id], onDelete: Cascade)
  @@map("rail_number") //テーブル名の定義
}
model TrainType {
  id        String   @id @default(uuid())
  code      Int      @unique // oud2ファイル内での種別インデックス (0, 1, 2...)
  name      String // 種別名 (例: 新快速)
  shortName String // 略称 (例: 新快)
  color     String? // 文字色・ダイヤ線色（必要に応じて）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // リレーション: 1つの種別に複数の列車が紐づく
  trains Train[]
  @@map("train_type") //テーブル名の定義
}

// 列車モデル 1本の列車の情報
model Train {
  id          String          @id @default(uuid())
  //route_id       Int
  trainNumber String // Ressyabangou (例: "5031M", "701M")
  trainName   String? // Ressyamei (例: "サンライズ瀬戸")
  direction   String // Houkou ("Kudari" または "Nobori")
  trainTypeId String
  trainType   TrainType       @relation(fields: [trainTypeId], references: [id])
  stopTimes   TrainStopTime[]
  // 1本の列車に対して、路線外発着データが「0〜2件」紐付く
  //outerDep  OuterTime[]
  //outerArrive OuterTime[]

  //route       Route @relation(fields: [route_id], references: [id], onDelete: Cascade)
  // 今後の拡張（車両運用・編成）を見据えたリレーション用の器（オプショナルにしておく）
  // vehicleUsageId String?
  @@map("train") //テーブル名の定義
}
/*enum Direction {
  Kudari // 下り
  Nobori // 上り
}*/
// 列車ごとの各駅の時刻・発着情報
model TrainStopTime {
  id        String   @id @default(uuid())
  trainId   String
  train     Train    @relation(fields: [trainId], references: [id], onDelete: Cascade)
  stationId Int
  station   Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  // oud2の「1;446$0」形式をパースして使いやすい形にする
  arrivalMinute   Int? // 0時からの通算経過分（例: 446）。通過・未経由・発のみの場合はnull
  departureMinute Int? // 0時からの通算経過分。着のみの場合はnull
  trackName       String? // $0 などの番線情報
  isPass          Boolean @default(false) // 通過駅フラグ（時刻表記がないが経由する場合など用）

  //@@unique([trainId, stationId]) // 1つの列車が同じ駅に登録されるのは1度のみ
  @@map("train_stop_time") //テーブル名の定義
}

model OuterTerminalStation {
  id                  Int      @id @default(autoincrement())
  station_id          Int
  terminal_id         Int? // JSON内のid（元データの識別子）
  name                String
  jikoku_raw          String? // 元のjikoku文字列（駅名や時刻など）
  // Trainへの路線外発着参照（どの列車の路線外始発/終着かを示す）
  diaryaku            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([station_id, terminal_id])
  @@index([station_id])
  @@index([terminal_id])
  @@map("outer_terminal_stations") //テーブル名の定義
}

model OuterTime {
  id                Int     @id @default(autoincrement())
  trainId           String
  train             Train     @relation(fields: [trainId], references: [id], onDelete: Cascade)
  // 役割の定義: "DEP" (路線外から出発して線内へ入る) または "ARR" (線内から路線外へ出て到着する)
  directionType     String    // "DEP" or "ARR"
  pointStationID    Int
  terminalStationID Int
  terminalTime      Int?
  pointTime         Int?

  @@map("outer_time")
}
